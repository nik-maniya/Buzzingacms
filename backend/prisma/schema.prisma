generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email         String         @unique
  password      String
  name          String
  role          Role           @default(VIEWER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  id            Int            @id @default(autoincrement())
  fields        Field[]
  collections   Collection[]
  forms         Form[]
  menus         Menu[]
  pageTemplates PageTemplate[]
  pages         Page[]

  @@map("users")
}

model Page {
  title       String
  slug        String
  content     Json?
  status      PageStatus @default(DRAFT)
  description String?
  keywords    String[]
  ogImage     String?
  isHomePage  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customCss   String?
  customJs    String?
  id          Int        @id @default(autoincrement())
  authorId    Int
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, slug])
  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@map("pages")
}

model Collection {
  name          String
  slug          String
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  id            Int              @id @default(autoincrement())
  authorId      Int
  fields        Field[]
  items         CollectionItem[]
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pageTemplates PageTemplate[]

  @@index([slug])
  @@index([authorId])
  @@map("collections")
}

model CollectionItem {
  data         Json
  status       String     @default("draft")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  id           Int        @id @default(autoincrement())
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("collection_items")
}

model Field {
  fieldType    String
  fieldLabel   String
  placeholder  String?
  defaultValue String?
  options      Json?
  required     Boolean    @default(false)
  order        Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  id           Int        @id @default(autoincrement())
  collectionId Int
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Media {
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  alt          String?
  caption      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  id           Int      @id @default(autoincrement())

  @@index([mimeType])
  @@map("media")
}

model Menu {
  name      String
  slug      String
  location  String?
  items     Json
  header    Json?
  footer    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        Int      @id @default(autoincrement())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([authorId])
  @@map("menus")
}

model Form {
  name        String
  slug        String
  description String?
  fields      Json
  settings    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  id          Int            @id @default(autoincrement())
  authorId    Int
  responses   FormResponse[]
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([authorId])
  @@map("forms")
}

model FormResponse {
  data      Json
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  formId    Int
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@map("form_responses")
}

model Redirect {
  fromPath    String   @unique
  toPath      String
  statusCode  Int      @default(301)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  id          Int      @id @default(autoincrement())

  @@index([fromPath])
  @@map("redirects")
}

model PageTemplate {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  htmlContent  String
  collectionId Int
  authorId     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([authorId])
  @@map("page_templates")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
